EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ship2aruba.com

# WhatsApp (architecture only — leave empty to skip)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Company (invoice)
COMPANY_NAME=Ship 2 Aruba
COMPANY_ADDRESS=Wayaca 43C, Oranjestad, Aruba
